# ----
# AWS Pricing API lookups
#
# aws_pricing_product fails the plan unless its filters match exactly one product, so each
# lookup filters on regionCode plus attributes that are identical in every region. Validate
# new filters against the Pricing API in every supported region before adding them.
# ----

# Zonal NAT gateway hours (NatGateway-Hours), not regional or provisioned-bandwidth NAT
data "aws_pricing_product" "nat_gateway_hours" {
  count = local.pricing_enabled ? 1 : 0

  service_code = "AmazonEC2"

  filters {
    field = "productFamily"
    value = "NAT Gateway"
  }

  filters {
    field = "operation"
    value = "NatGateway"
  }

  filters {
    field = "groupDescription"
    value = "Hourly charge for NAT Gateways"
  }

  filters {
    field = "regionCode"
    value = var.region
  }
}

# Data processed by zonal NAT gateways (NatGateway-Bytes)
data "aws_pricing_product" "nat_gateway_data" {
  count = local.pricing_enabled ? 1 : 0

  service_code = "AmazonEC2"

  filters {
    field = "productFamily"
    value = "NAT Gateway"
  }

  filters {
    field = "operation"
    value = "NatGateway"
  }

  filters {
    field = "groupDescription"
    value = "Charge for per GB data processed by NatGateways"
  }

  filters {
    field = "regionCode"
    value = var.region
  }
}

